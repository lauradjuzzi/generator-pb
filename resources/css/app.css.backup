@import 'tailwindcss';

@source '../../vendor/laravel/framework/src/Illuminate/Pagination/resources/views/*.blade.php';
@source '../../storage/framework/views/*.php';
@source '../**/*.blade.php';
@source '../**/*.js';

@theme {
    --font-sans: 'Instrument Sans', ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji',
        'Segoe UI Symbol', 'Noto Color Emoji';
}

/* =========================================================
   BRK SYARIAH DESIGN SYSTEM
   ========================================================= */

:root {
    --brk-red: #c62828;
    --brk-red-dark: #9f1f1f;
    --brk-red-soft: #fce8e8;

    --brk-green: #087f5b;
    --brk-green-dark: #056044;
    --brk-green-soft: #e7f6f0;

    --brk-orange: #f59f00;
    --brk-orange-dark: #d98200;
    --brk-orange-soft: #fff4d6;

    --brk-white: #ffffff;
    --brk-bg: #f5f7f6;
    --brk-surface: #ffffff;

    --brk-text: #17201d;
    --brk-text-soft: #52605a;
    --brk-muted: #7a8580;

    --brk-border: #e2e8e5;

    --brk-shadow-sm: 0 4px 14px rgba(20, 55, 43, 0.06);
    --brk-shadow-md: 0 12px 30px rgba(20, 55, 43, 0.09);
    --brk-shadow-lg: 0 24px 60px rgba(20, 55, 43, 0.12);

    --brk-radius-sm: 8px;
    --brk-radius-md: 12px;
    --brk-radius-lg: 18px;
    --brk-radius-xl: 24px;

    --brk-transition: 180ms ease;
    --brk-transition-slow: 350ms ease;
}

/* =========================================================
   BASE
   ========================================================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    min-height: 100vh;
    background: var(--brk-bg);
    color: var(--brk-text);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}

button,
input,
select,
textarea {
    font: inherit;
}

button,
a {
    -webkit-tap-highlight-color: transparent;
}

a {
    color: inherit;
}

::selection {
    color: var(--brk-white);
    background: var(--brk-green);
}

button,
a,
input,
select,
textarea {
    transition:
        color var(--brk-transition),
        background-color var(--brk-transition),
        border-color var(--brk-transition),
        box-shadow var(--brk-transition),
        transform var(--brk-transition),
        opacity var(--brk-transition);
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
    outline: 3px solid rgba(245, 159, 0, 0.32);
    outline-offset: 3px;
}

/* =========================================================
   APP LAYOUT
   ========================================================= */

.brk-app-body {
    overflow-x: hidden;
}

.app-layout {
    display: flex;
    min-height: 100vh;
    background:
        radial-gradient(circle at 85% 8%,
            rgba(245, 159, 0, 0.06),
            transparent 28%),
        var(--brk-bg);
}

/* =========================================================
   SIDEBAR
   ========================================================= */

.app-sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 30;
    display: flex;
    flex-direction: column;
    width: 270px;
    min-height: 100vh;
    padding: 28px 18px 20px;
    overflow: hidden;
    color: #fff;
    background:
        linear-gradient(155deg,
            #9f1f1f 0%,
            #c62828 35%,
            #087f5b 100%);
    box-shadow: 10px 0 35px rgba(20, 55, 43, 0.10);
}

.app-sidebar::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
        linear-gradient(180deg,
            rgba(255, 255, 255, 0.08),
            transparent 35%);
}

.app-sidebar-decoration {
    position: absolute;
    border-radius: 999px;
    pointer-events: none;
}

.app-sidebar-decoration-one {
    width: 180px;
    height: 180px;
    top: -80px;
    right: -75px;
    background: rgba(245, 159, 0, 0.22);
}

.app-sidebar-decoration-two {
    width: 230px;
    height: 230px;
    bottom: -135px;
    left: -100px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.05);
}

.app-brand-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 8px 28px;
}

.app-brand-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.14);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.18),
        0 8px 20px rgba(0, 0, 0, 0.10);
    backdrop-filter: blur(8px);
}

.app-brand-mark span {
    color: #fff;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -0.5px;
}

.app-brand {
    margin: 0;
    color: #fff;
    font-size: 19px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.3px;
}

.app-brand-subtitle {
    margin: 5px 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 11px;
    line-height: 1.4;
}

.app-nav {
    position: relative;
    z-index: 1;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 0 2px;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.18) transparent;
}

.app-nav-label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 19px 10px 8px;
    color: rgba(255, 255, 255, 0.54);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.3px;
    line-height: 1;
    text-transform: uppercase;
}

.app-nav-label:first-child {
    margin-top: 0;
}

.app-nav-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.10);
}

.app-nav-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 46px;
    margin-bottom: 5px;
    padding: 10px 12px;
    border: 1px solid transparent;
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 12.5px;
    font-weight: 550;
    text-decoration: none;
    transform: translateX(0);
}

.app-nav-item:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.10);
    border-color: rgba(255, 255, 255, 0.08);
    transform: translateX(3px);
}

.app-nav-item.active {
    color: var(--brk-green-dark);
    background: #fff;
    border-color: rgba(255, 255, 255, 0.60);
    font-weight: 750;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.10);
}

.app-nav-item.active::before {
    content: '';
    position: absolute;
    left: -2px;
    top: 10px;
    bottom: 10px;
    width: 3px;
    border-radius: 999px;
    background: var(--brk-orange);
}

.app-nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 25px;
    height: 25px;
    flex-shrink: 0;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.82);
    background: rgba(255, 255, 255, 0.08);
    font-size: 14px;
    line-height: 1;
}

.app-nav-item.active .app-nav-icon {
    color: var(--brk-red);
    background: var(--brk-red-soft);
}

.app-sidebar-footer {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.60);
    font-size: 10px;
}

.app-status-dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #7be495;
    box-shadow: 0 0 0 4px rgba(123, 228, 149, 0.12);
}

/* =========================================================
   MAIN
   ========================================================= */

.app-main {
    flex: 1;
    min-width: 0;
    min-height: 100vh;
    margin-left: 270px;
}

.app-topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 78px;
    padding: 14px 34px;
    border-bottom: 1px solid rgba(226, 232, 229, 0.90);
    background: rgba(255, 255, 255, 0.90);
    box-shadow: 0 4px 20px rgba(20, 55, 43, 0.035);
    backdrop-filter: blur(16px);
}

.app-topbar-left {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
}

.app-topbar-mobile-brand {
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 11px;
    color: #fff;
    background: linear-gradient(135deg,
            var(--brk-red),
            var(--brk-green));
    font-size: 11px;
    font-weight: 800;
}

.app-topbar-label {
    color: var(--brk-muted);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.3;
}

.app-topbar-title {
    margin-top: 2px;
    color: var(--brk-text);
    font-size: 15px;
    font-weight: 800;
    line-height: 1.3;
}

.app-user-area {
    display: flex;
    align-items: center;
    gap: 11px;
}

.app-user-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border: 3px solid #fff;
    border-radius: 50%;
    color: #fff;
    background:
        linear-gradient(135deg,
            var(--brk-red),
            var(--brk-orange));
    box-shadow: 0 3px 12px rgba(198, 40, 40, 0.18);
    font-size: 13px;
    font-weight: 800;
}

.app-user-info {
    display: flex;
    flex-direction: column;
    min-width: 80px;
}

.app-user-name {
    color: var(--brk-text);
    font-size: 12px;
    font-weight: 750;
    line-height: 1.3;
}

.app-user-role {
    margin-top: 2px;
    color: var(--brk-muted);
    font-size: 10px;
    line-height: 1.3;
}

.app-logout-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 8px 13px;
    border: 1px solid var(--brk-border);
    border-radius: 10px;
    color: var(--brk-text-soft);
    background: #fff;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
}

.app-logout-button:hover {
    color: #fff;
    border-color: var(--brk-red);
    background: var(--brk-red);
    box-shadow: 0 6px 15px rgba(198, 40, 40, 0.16);
    transform: translateY(-1px);
}

.app-content {
    width: 100%;
    max-width: 1500px;
    padding: 32px 34px 48px;
    margin: 0 auto;
}

/* =========================================================
   ALERT
   ========================================================= */

.alert {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
    padding: 13px 16px;
    border: 1px solid transparent;
    border-radius: var(--brk-radius-md);
    font-size: 13px;
    line-height: 1.5;
    animation: brk-alert-in 350ms ease both;
}

.alert-success {
    border-color: #bce7d7;
    color: var(--brk-green-dark);
    background: var(--brk-green-soft);
}

.alert-error,
.alert-danger {
    border-color: #f2c4c4;
    color: var(--brk-red-dark);
    background: var(--brk-red-soft);
}

.brk-alert {
    box-shadow: var(--brk-shadow-sm);
}

.brk-alert-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 31px;
    height: 31px;
    flex-shrink: 0;
    border-radius: 50%;
    color: #fff;
    background: var(--brk-green);
    font-size: 14px;
    font-weight: 800;
}

.brk-alert-content {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
}

.brk-alert-content strong {
    font-size: 12px;
    font-weight: 800;
}

.brk-alert-content span {
    font-size: 12px;
}

.brk-alert-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-left: auto;
    padding: 0;
    border: 0;
    border-radius: 8px;
    color: currentColor;
    background: transparent;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    opacity: 0.65;
}

.brk-alert-close:hover {
    background: rgba(0, 0, 0, 0.05);
    opacity: 1;
}

@keyframes brk-alert-in {
    from {
        opacity: 0;
        transform: translateY(-8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* =========================================================
   GLOBAL CARDS
   ========================================================= */

.brk-card {
    border: 1px solid var(--brk-border);
    border-radius: var(--brk-radius-lg);
    background: var(--brk-surface);
    box-shadow: var(--brk-shadow-sm);
}

.brk-card:hover {
    box-shadow: var(--brk-shadow-md);
}

/* =========================================================
   BADGES
   ========================================================= */

.brk-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 28px;
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
}

.brk-badge-green {
    color: var(--brk-green-dark);
    background: var(--brk-green-soft);
}

.brk-badge-red {
    color: var(--brk-red-dark);
    background: var(--brk-red-soft);
}

.brk-badge-orange {
    color: var(--brk-orange-dark);
    background: var(--brk-orange-soft);
}

/* =========================================================
   FORM ELEMENTS
   ========================================================= */

input,
select,
textarea {
    border-color: var(--brk-border);
}

input:focus,
select:focus,
textarea:focus {
    border-color: var(--brk-green);
    box-shadow: 0 0 0 4px rgba(8, 127, 91, 0.11);
}

/* =========================================================
   ANIMATION UTILITIES
   ========================================================= */

.brk-animate-in {
    animation: brk-fade-up 450ms ease both;
}

.brk-animate-delay-1 {
    animation-delay: 80ms;
}

.brk-animate-delay-2 {
    animation-delay: 160ms;
}

.brk-animate-delay-3 {
    animation-delay: 240ms;
}

.brk-float {
    animation: brk-float 4s ease-in-out infinite;
}

@keyframes brk-fade-up {
    from {
        opacity: 0;
        transform: translateY(14px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes brk-float {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-8px);
    }
}

/* =========================================================
   FLATPICKR
   ========================================================= */

.flatpickr-calendar {
    width: 310px !important;
    border: 1px solid var(--brk-border) !important;
    border-radius: var(--brk-radius-md) !important;
    box-shadow: var(--brk-shadow-lg) !important;
    overflow: hidden;
}

.flatpickr-months {
    height: 48px !important;
    align-items: center;
}

.flatpickr-current-month {
    display: flex !important;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 75% !important;
    left: 12.5% !important;
    padding: 0 !important;
}

.flatpickr-current-month .flatpickr-monthDropdown-months {
    width: auto !important;
    min-width: 115px;
    max-width: 130px;
    font-size: 16px !important;
}

.flatpickr-current-month input.cur-year {
    width: 55px !important;
    min-width: 55px !important;
    padding: 0 !important;
    font-size: 16px !important;
    text-align: center;
}

.flatpickr-prev-month,
.flatpickr-next-month {
    top: 10px !important;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1000px) {
    .app-sidebar {
        width: 230px;
    }

    .app-main {
        margin-left: 230px;
    }

    .app-content {
        padding-right: 24px;
        padding-left: 24px;
    }

    .app-topbar {
        padding-right: 24px;
        padding-left: 24px;
    }

    .app-user-info {
        display: none;
    }
}

@media (max-width: 800px) {
    .app-layout {
        display: block;
    }

    .app-sidebar {
        position: relative;
        inset: auto;
        width: 100%;
        min-height: auto;
        max-height: none;
        padding: 18px 16px;
    }

    .app-brand-wrap {
        padding-bottom: 18px;
    }

    .app-nav {
        overflow: visible;
    }

    .app-nav-label {
        margin-top: 15px;
    }

    .app-nav-item {
        min-height: 42px;
    }

    .app-sidebar-footer {
        display: none;
    }

    .app-main {
        min-height: auto;
        margin-left: 0;
    }

    .app-topbar {
        position: sticky;
        top: 0;
        min-height: 66px;
        padding: 12px 16px;
    }

    .app-topbar-mobile-brand {
        display: flex;
    }

    .app-topbar-title {
        font-size: 14px;
    }

    .app-user-area {
        gap: 8px;
    }

    .app-user-avatar {
        width: 34px;
        height: 34px;
    }

    .app-logout-button {
        min-height: 34px;
        padding: 7px 10px;
    }

    .app-content {
        padding: 22px 16px 36px;
    }
}

@media (max-width: 520px) {
    .app-topbar-label {
        display: none;
    }

    .app-topbar-title {
        font-size: 13px;
    }

    .app-user-avatar {
        display: none;
    }

    .app-logout-button span {
        font-size: 10px;
    }

    .app-content {
        padding-right: 12px;
        padding-left: 12px;
    }

    .brk-alert {
        align-items: flex-start;
    }
}

/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }

    /* =========================================================
   TOP UP PAGE
   ========================================================= */

    .brk-page-head {
        margin-bottom: 28px;
    }

    .brk-back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        color: var(--brk-text-soft);
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
    }

    .brk-back-link:hover {
        color: var(--brk-red);
        transform: translateX(-2px);
    }

    .brk-back-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border: 1px solid var(--brk-border);
        border-radius: 9px;
        background: #fff;
        font-size: 15px;
    }

    .brk-page-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 30px;
    }

    .brk-page-eyebrow {
        display: inline-block;
        margin-bottom: 7px;
        color: var(--brk-red);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.5px;
    }

    .brk-page-heading h1 {
        margin: 0;
        color: var(--brk-text);
        font-size: clamp(25px, 3vw, 34px);
        font-weight: 850;
        letter-spacing: -1px;
        line-height: 1.15;
    }

    .brk-page-heading p {
        max-width: 680px;
        margin: 10px 0 0;
        color: var(--brk-text-soft);
        font-size: 13px;
        line-height: 1.7;
    }

    .brk-page-accent {
        display: flex;
        align-items: center;
        gap: 6px;
        padding-top: 8px;
    }

    .brk-page-accent span {
        display: block;
        width: 9px;
        height: 9px;
        border-radius: 50%;
    }

    .brk-page-accent span:nth-child(1) {
        background: var(--brk-red);
    }

    .brk-page-accent span:nth-child(2) {
        background: var(--brk-orange);
    }

    .brk-page-accent span:nth-child(3) {
        background: var(--brk-green);
    }


    /* =========================================================
   PB CHOICE
   ========================================================= */

    .brk-pb-choice-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .brk-pb-choice {
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 300px;
        padding: 24px;
        overflow: hidden;
        border: 1px solid var(--brk-border);
        border-radius: 22px;
        color: var(--brk-text);
        background: #fff;
        box-shadow: var(--brk-shadow-sm);
        text-decoration: none;
        isolation: isolate;
    }

    .brk-pb-choice::before {
        content: '';
        position: absolute;
        top: -80px;
        right: -70px;
        z-index: -1;
        width: 210px;
        height: 210px;
        border-radius: 50%;
        opacity: 0.75;
        transition: transform 400ms ease;
    }

    .brk-pb-choice-red::before {
        background: var(--brk-red-soft);
    }

    .brk-pb-choice-green::before {
        background: var(--brk-green-soft);
    }

    .brk-pb-choice::after {
        content: '';
        position: absolute;
        right: -55px;
        bottom: -85px;
        z-index: -1;
        width: 180px;
        height: 180px;
        border: 1px solid rgba(245, 159, 0, 0.16);
        border-radius: 50%;
    }

    .brk-pb-choice:hover {
        border-color: transparent;
        box-shadow: var(--brk-shadow-lg);
        transform: translateY(-5px);
    }

    .brk-pb-choice:hover::before {
        transform: scale(1.18);
    }

    .brk-pb-choice-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .brk-pb-number {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 850;
        letter-spacing: 0.8px;
    }

    .brk-pb-choice-red .brk-pb-number {
        color: var(--brk-red-dark);
        background: var(--brk-red-soft);
    }

    .brk-pb-choice-green .brk-pb-number {
        color: var(--brk-green-dark);
        background: var(--brk-green-soft);
    }

    .brk-pb-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        border-radius: 16px;
        font-size: 25px;
        font-weight: 800;
    }

    .brk-pb-choice-red .brk-pb-icon {
        color: var(--brk-red);
        background: var(--brk-red-soft);
    }

    .brk-pb-choice-green .brk-pb-icon {
        color: var(--brk-green);
        background: var(--brk-green-soft);
    }

    .brk-pb-choice-body {
        flex: 1;
        padding-top: 35px;
    }

    .brk-pb-label {
        color: var(--brk-muted);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.2px;
    }

    .brk-pb-choice h2 {
        margin: 8px 0 9px;
        color: var(--brk-text);
        font-size: 22px;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .brk-pb-choice p {
        max-width: 440px;
        margin: 0;
        color: var(--brk-text-soft);
        font-size: 12px;
        line-height: 1.7;
    }

    .brk-pb-choice-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 26px;
        padding-top: 17px;
        border-top: 1px solid var(--brk-border);
        color: var(--brk-text-soft);
        font-size: 11px;
        font-weight: 750;
    }

    .brk-pb-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 10px;
        font-size: 16px;
    }

    .brk-pb-choice-red .brk-pb-arrow {
        color: var(--brk-red);
        background: var(--brk-red-soft);
    }

    .brk-pb-choice-green .brk-pb-arrow {
        color: var(--brk-green);
        background: var(--brk-green-soft);
    }

    .brk-pb-choice:hover .brk-pb-arrow {
        transform: translateX(3px);
    }


    /* =========================================================
   PREVIEW BAR
   ========================================================= */

    .brk-preview-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 22px;
        padding: 18px 20px;
        border: 1px solid #d9e9e2;
        border-radius: 17px;
        background:
            linear-gradient(100deg,
                #ffffff,
                var(--brk-green-soft));
        box-shadow: var(--brk-shadow-sm);
    }

    .brk-preview-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .brk-preview-status {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--brk-green-dark);
        font-size: 12px;
        font-weight: 800;
    }

    .brk-preview-info>span {
        color: var(--brk-muted);
        font-size: 11px;
    }

    .brk-status-pulse {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--brk-green);
        box-shadow: 0 0 0 5px rgba(8, 127, 91, 0.10);
        animation: brk-status-pulse 2s ease-in-out infinite;
    }

    @keyframes brk-status-pulse {

        0%,
        100% {
            box-shadow: 0 0 0 4px rgba(8, 127, 91, 0.08);
        }

        50% {
            box-shadow: 0 0 0 7px rgba(8, 127, 91, 0.14);
        }
    }

    .brk-preview-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-height: 43px;
        padding: 10px 17px;
        flex-shrink: 0;
        border-radius: 11px;
        color: #fff;
        background: var(--brk-green);
        box-shadow: 0 7px 18px rgba(8, 127, 91, 0.18);
        font-size: 11px;
        font-weight: 800;
        text-decoration: none;
    }

    .brk-preview-button:hover {
        background: var(--brk-green-dark);
        box-shadow: 0 10px 22px rgba(8, 127, 91, 0.23);
        transform: translateY(-2px);
    }


    /* =========================================================
   TOP UP PAGE
   ========================================================= */

    .brk-page-head {
        margin-bottom: 32px;
    }

    .brk-back-link {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 26px;
        color: var(--brk-text-soft);
        font-size: 13px;
        font-weight: 650;
        text-decoration: none;
    }

    .brk-back-link:hover {
        color: var(--brk-red);
    }

    .brk-back-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border: 1px solid var(--brk-border);
        border-radius: 9px;
        background: var(--brk-white);
    }

    .brk-page-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
    }

    .brk-page-eyebrow {
        display: block;
        margin-bottom: 8px;
        color: var(--brk-red);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.5px;
    }

    .brk-page-heading h1 {
        margin: 0;
        color: var(--brk-text);
        font-size: 32px;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.8px;
    }

    .brk-page-heading p {
        max-width: 700px;
        margin: 10px 0 0;
        color: var(--brk-text-soft);
        font-size: 14px;
        line-height: 1.7;
    }

    .brk-page-accent {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .brk-page-accent span {
        display: block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .brk-page-accent span:nth-child(1) {
        background: var(--brk-red);
    }

    .brk-page-accent span:nth-child(2) {
        background: var(--brk-orange);
    }

    .brk-page-accent span:nth-child(3) {
        background: var(--brk-green);
    }


    /* =========================================================
   PB DOCUMENT CARDS
   ========================================================= */

    .brk-pb-choice-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
    }

    .brk-pb-choice {
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 320px;
        padding: 28px;
        overflow: hidden;
        border: 1px solid var(--brk-border);
        border-radius: 20px;
        color: var(--brk-text);
        background: var(--brk-white);
        box-shadow: var(--brk-shadow-sm);
        text-decoration: none;
        transition:
            transform 220ms ease,
            box-shadow 220ms ease,
            border-color 220ms ease;
    }

    .brk-pb-choice:hover {
        transform: translateY(-5px);
        box-shadow: var(--brk-shadow-lg);
    }

    .brk-pb-choice-red:hover {
        border-color: rgba(198, 40, 40, 0.25);
    }

    .brk-pb-choice-green:hover {
        border-color: rgba(8, 127, 91, 0.25);
    }

    .brk-pb-choice::before {
        content: '';
        position: absolute;
        top: -90px;
        right: -90px;
        width: 240px;
        height: 240px;
        border-radius: 50%;
        transition: transform 400ms ease;
        z-index: 0;
    }

    .brk-pb-choice-red::before {
        background: var(--brk-red-soft);
    }

    .brk-pb-choice-green::before {
        background: var(--brk-green-soft);
    }

    .brk-pb-choice:hover::before {
        transform: scale(1.12);
    }

    .brk-pb-choice-top,
    .brk-pb-choice-body,
    .brk-pb-choice-footer {
        position: relative;
        z-index: 1;
    }

    .brk-pb-choice-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
    }

    .brk-pb-number {
        display: inline-flex;
        align-items: center;
        min-height: 30px;
        padding: 6px 11px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.8px;
    }

    .brk-pb-choice-red .brk-pb-number {
        color: var(--brk-red-dark);
        background: var(--brk-red-soft);
    }

    .brk-pb-choice-green .brk-pb-number {
        color: var(--brk-green-dark);
        background: var(--brk-green-soft);
    }

    .brk-pb-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        border-radius: 15px;
        font-size: 24px;
        font-weight: 800;
    }

    .brk-pb-choice-red .brk-pb-icon {
        color: var(--brk-red);
        background: var(--brk-red-soft);
    }

    .brk-pb-choice-green .brk-pb-icon {
        color: var(--brk-green);
        background: var(--brk-green-soft);
    }

    .brk-pb-choice-body {
        flex: 1;
        padding-top: 42px;
    }

    .brk-pb-label {
        display: block;
        margin-bottom: 8px;
        color: var(--brk-muted);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.3px;
    }

    .brk-pb-choice h2 {
        margin: 0 0 10px;
        color: var(--brk-text);
        font-size: 23px;
        font-weight: 800;
        line-height: 1.25;
    }

    .brk-pb-choice p {
        max-width: 430px;
        margin: 0;
        color: var(--brk-text-soft);
        font-size: 13px;
        line-height: 1.7;
    }

    .brk-pb-choice-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 28px;
        padding-top: 17px;
        border-top: 1px solid var(--brk-border);
        color: var(--brk-text-soft);
        font-size: 12px;
        font-weight: 750;
    }

    .brk-pb-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        font-size: 17px;
        transition: transform 180ms ease;
    }

    .brk-pb-choice-red .brk-pb-arrow {
        color: var(--brk-red);
        background: var(--brk-red-soft);
    }

    .brk-pb-choice-green .brk-pb-arrow {
        color: var(--brk-green);
        background: var(--brk-green-soft);
    }

    .brk-pb-choice:hover .brk-pb-arrow {
        transform: translateX(4px);
    }


    /* =========================================================
   PREVIEW
   ========================================================= */

    .brk-preview-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-top: 24px;
        padding: 20px 22px;
        border: 1px solid #d7e8e1;
        border-radius: 16px;
        background: linear-gradient(100deg,
                #ffffff,
                var(--brk-green-soft));
        box-shadow: var(--brk-shadow-sm);
    }

    .brk-preview-info {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .brk-preview-status {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--brk-green-dark);
        font-size: 13px;
        font-weight: 800;
    }

    .brk-preview-info>span {
        color: var(--brk-muted);
        font-size: 12px;
    }

    .brk-status-pulse {
        width: 8px;
        height: 8px;
        flex-shrink: 0;
        border-radius: 50%;
        background: var(--brk-green);
        box-shadow: 0 0 0 5px rgba(8, 127, 91, 0.1);
    }

    .brk-preview-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-height: 44px;
        padding: 11px 18px;
        flex-shrink: 0;
        border-radius: 11px;
        color: #fff;
        background: var(--brk-green);
        box-shadow: 0 7px 18px rgba(8, 127, 91, 0.18);
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
    }

    .brk-preview-button:hover {
        color: #fff;
        background: var(--brk-green-dark);
        transform: translateY(-2px);
    }


    /* =========================================================
   ANIMATION
   ========================================================= */

    .brk-animate-in {
        animation: brk-topup-enter 420ms ease both;
    }

    .brk-animate-delay-1 {
        animation-delay: 80ms;
    }

    .brk-animate-delay-2 {
        animation-delay: 150ms;
    }

    .brk-animate-delay-3 {
        animation-delay: 220ms;
    }

    @keyframes brk-topup-enter {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =========================================================
   RESPONSIVE
   ========================================================= */

    @media (max-width: 800px) {
        .brk-page-heading {
            align-items: flex-start;
        }

        .brk-page-heading h1 {
            font-size: 27px;
        }

        .brk-page-accent {
            display: none;
        }

        .brk-pb-choice-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 600px) {
        .brk-pb-choice {
            min-height: 290px;
            padding: 22px;
        }

        .brk-preview-bar {
            align-items: stretch;
            flex-direction: column;
        }

        .brk-preview-button {
            width: 100%;
        }
    }
}